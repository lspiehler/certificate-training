{
  "logging":{
    "logs":{
      "default":{
        "level":"DEBUG",
        "writer":{
          "output":"stderr"
        }
      }
    }
  },
  "apps":{
    "http":{
      "http_port":9080,
      "https_port":9443,
      "servers":{
        "server1":{
          "listen":[
            "0.0.0.0:9443"
          ],
          "routes":[
            {
              "match":[
                {
                  "path":[
                    "/*"
                  ]
                }
              ],
              "handle":[
                {
                  "handler":"static_response",
                  "status_code":"200",
                  "body":"Hello World!"
                },
                {
                  "handler":"headers",
                  "response":{
                    "set":{
                      "hello":[
                        "goodbye"
                      ]
                    }
                  }
                }
              ]
            }
          ],
		  "tls_connection_policies": [
            {
              "match": {
                "sni": ["*"]
              },
              "certificate_selection": {
				"any_tag": ["default"]
			  }
            }
          ],
          "logs":{
            "default_logger_name":"access"
          }
        }
      }
    },
    "tls":{
      "certificates":{
        "load_files":[
          {
            "certificate":"caddy.crt",
            "key":"caddy.key",
			"tags": ["default"]
          }
        ]
      }
    }
  }
}